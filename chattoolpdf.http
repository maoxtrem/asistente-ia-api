###
# chattoolpdf request model
#
# Common fields:
# - message: required
# - tool: optional, default false
# - tenant: required when tool=true
# - usuario: required when tool=true
# - locale: optional, default normalized by backend
# - conversation_id: optional, reuse for the same thread
# - client_key: optional, useful for tracing
# - history: optional array of previous messages
# - context: optional extra context for the model
# - metadata: optional tracing/debug data
#
# Attachment fields:
# - adjunto, archivo, or pdf: any of these can carry the attachment object
# - content_base64: required when you want the backend to extract text from the file
# - mime_type and name help the backend detect the file type
# - adjunto_action is optional; the backend currently infers the mode from tool + message intent
#
# Backend behavior:
# - tool=false -> conversational answer only, no PDF generation
# - tool=true -> PDF generation is allowed, but only if the message expresses a document-generation intent
# - tool=false and attachment -> attachment is treated as context for analysis/chat
# - tool=true and attachment -> attachment is treated as context for document generation only when the message asks for it

###
# 1) Modo pregunta, sin adjunto
# Use this when you want a direct conversational answer.
POST https://asistente-ia-api.localhost/api/chattoolpdf
Content-Type: application/json
Accept: application/json

{
  "message": "Hola, que puedes hacer?",
  "tool": false,
  "locale": "es",
  "conversation_id": "f1a2b3c4d5e6f708192a3b4c5d6e7f80",
  "client_key": "cliente-demo",
  "history": [
    {
      "role": "user",
      "content": "Hola"
    },
    {
      "role": "assistant",
      "content": "Hola, en que te ayudo?"
    }
  ]
}

###
# 2) Modo pregunta, con adjunto
# Use this when you want the model to explain or summarize the attachment.
POST https://asistente-ia-api.localhost/api/chattoolpdf
Content-Type: application/json
Accept: application/json

{
  "message": "Resume el contenido del archivo adjunto y dame los puntos clave.",
  "tool": false,
  "locale": "es",
  "conversation_id": "f1a2b3c4d5e6f708192a3b4c5d6e7f81",
  "client_key": "cliente-demo",
  "adjunto": {
    "name": "resumen.txt",
    "mime_type": "text/plain",
    "size": 30,
    "content_base64": "UmV2aXNhIGVsIGRvY3VtZW50by4="
  }
}

###
# 3) Modo generativo, sin adjunto
# Use this when you want the AI to create a PDF document from the prompt.
POST https://asistente-ia-api.localhost/api/chattoolpdf
Content-Type: application/json
Accept: application/json

{
  "message": "Genera una cotizacion formal para un servicio de consultoria estrategica para Demo SAS.",
  "tool": true,
  "tenant": "tenant-demo",
  "usuario": "usuario-demo",
  "locale": "es",
  "conversation_id": "f1a2b3c4d5e6f708192a3b4c5d6e7f82",
  "client_key": "cliente-demo"
}

###
# 4) Modo generativo, con adjunto
# Use this when the PDF should be based on the attached file.
POST https://asistente-ia-api.localhost/api/chattoolpdf
Content-Type: application/json
Accept: application/json

{
  "message": "Convierte este archivo en una propuesta comercial profesional y moderna.",
  "tool": true,
  "tenant": "tenant-demo",
  "usuario": "usuario-demo",
  "locale": "es",
  "conversation_id": "f1a2b3c4d5e6f708192a3b4c5d6e7f83",
  "client_key": "cliente-demo",
  "adjunto_action": "document",
  "adjunto": {
    "name": "propuesta.txt",
    "mime_type": "text/plain",
    "size": 44,
    "content_base64": "UHJvcHVlc3RhIGRlIHNlcnZpY2lvcyB5IHByZWNpb3Mu"
  }
}

###
# Notes
# - If adjunto_action is omitted, the backend infers it.
# - If you send a PDF, the backend tries to extract text with pdftotext.
# - For binary files, replace content_base64 with the real file content encoded in base64.

###
# 5) Modo pregunta con PDF local de prueba
# Use this commented block to test the endpoint with the local PDF:
# /home/maoxtrem/proyectos/entorno_desarrollo_local/dev/asistente-ia-api/c5f9c23436266d0e3f3a8a283304d062065705dc213b2df8001de720409aecb0.pdf
#
# To generate content_base64 locally, run:
# base64 -w 0 /home/maoxtrem/proyectos/entorno_desarrollo_local/dev/asistente-ia-api/c5f9c23436266d0e3f3a8a283304d062065705dc213b2df8001de720409aecb0.pdf
